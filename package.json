{
  "name": "today-new-toys",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "今天又有什么新玩具 — 中文开源项目与互联网工具发现站",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:check && npm run data:build && tsc -b && vite build && node scripts/prerender.mjs && node scripts/postbuild.mjs",
    "build:client": "tsc -b && vite build",
    "preview": "vite preview --port 4188 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:layout": "node tests/e2e/layout-audit.mjs",
    "check": "npm run data:check && npm run typecheck && npm run test && npm run build",
    "data:fetch": "node scripts/fetch.mjs",
    "data:update": "node scripts/ingest.mjs update",
    "data:build": "node scripts/build-data.mjs",
    "data:check": "node scripts/validate-data.mjs",
    "data:import": "node scripts/ingest.mjs import",
    "data:verify": "node scripts/ingest.mjs verify",
    "auto:publish": "node scripts/auto-pipeline.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "shots:retry": "node scripts/recapture.mjs",
    "og": "python scripts/og-images.py",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "homepage": "https://iiiiiiiiiiiiikk.github.io/today-new-toys/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiiiiiiiiiiiiKK/today-new-toys.git"
  },
  "author": {
    "name": "0xkillcoin",
    "url": "https://x.com/0xkillcoin"
  },
  "keywords": [
    "开源项目",
    "工具发现",
    "中文",
    "github-pages",
    "static-site",
    "react",
    "vite"
  ]
}
